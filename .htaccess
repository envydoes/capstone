# Force UTF-8 encoding for all responses
AddDefaultCharset UTF-8

RewriteEngine On
RewriteBase /

# Do not expose directory listings.
Options -Indexes
DirectoryIndex landing.php

# Keep real files and directories working as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Root request should load the site homepage instead of showing the directory index.
RewriteRule ^/?$ landing.php [L]

# Redirect .php URLs to clean URLs.
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php(?:[\s?]|$) [NC]
RewriteRule ^ %1 [R=301,L]

# Internally map clean URLs to existing .php files.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]